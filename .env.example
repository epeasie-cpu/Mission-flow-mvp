# Local dev only — synthetic data. Copy to .env.local
DATABASE_URL=postgres://mf_app:mf_app@localhost:5433/missionflow
DATABASE_URL_OWNER=postgres://mf_owner:mf_owner@localhost:5433/missionflow
DEMO_PASSCODE=change-me-local
SESSION_SECRET=at-least-32-random-characters-here-please

# Business time zone (G18). Never rely on the host TZ (Vercel runs in UTC).
MF_BUSINESS_TZ=America/Chicago

# Pilot + closing set (approved defaults; see src/config/missionflow.config.ts)
MF_ENABLED_CATEGORIES=awards_package
# MF_CLOSING_DISPOSITIONS=completed,submitted,no_equity_validated,cancelled_obe
MF_DEFAULT_BUFFER_DAYS=2

# AI (G19, approved): commercial model ONLY in the production public-demo deployment.
# Locally and in previews this always resolves to the template provider, whatever is set here.
MF_DEPLOYMENT=local
MF_AI_COMMERCIAL_ENABLED=false
MF_AI_GATEWAY_MODEL=openai/gpt-5.4-nano
MF_AI_GATEWAY_FALLBACK_MODELS=anthropic/claude-haiku-4.5
# AI_GATEWAY_API_KEY=   # only in the public-demo project (or use OIDC there). Never commit it.

# Optional private denylist for scripts/check-banned-names.mjs. Never commit real names.
# CI reads the optional secret MF_DENYLIST and still passes when that secret is absent.
# MF_DENYLIST=
